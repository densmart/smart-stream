<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background">

    <!-- Settings Button (Top Right) -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/tv_margin_large"
        android:background="@drawable/settings_button_background"
        android:contentDescription="@string/settings_title"
        android:padding="@dimen/tv_padding_medium"
        android:src="@drawable/ic_settings"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Main Content (Centered) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/tv_padding_large">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tv_margin_xlarge"
        android:text="@string/auth_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tv_text_size_title" />

    <EditText
        android:id="@+id/et_login"
        android:layout_width="400dp"
        android:layout_height="@dimen/input_height"
        android:layout_marginBottom="@dimen/tv_margin_medium"
        android:background="@drawable/edittext_focused"
        android:hint="@string/auth_login_hint"
        android:inputType="text"
        android:padding="@dimen/tv_padding_medium"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <EditText
        android:id="@+id/et_password"
        android:layout_width="400dp"
        android:layout_height="@dimen/input_height"
        android:layout_marginBottom="@dimen/tv_margin_large"
        android:background="@drawable/edittext_focused"
        android:hint="@string/auth_password_hint"
        android:inputType="textPassword"
        android:padding="@dimen/tv_padding_medium"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <Button
        android:id="@+id/btn_sign_in"
        android:layout_width="400dp"
        android:layout_height="@dimen/button_height"
        android:background="@drawable/button_focused"
        android:text="@string/auth_sign_in_button"
        android:textColor="@color/white"
        android:textSize="@dimen/tv_text_size_medium"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_margin_medium"
        android:gravity="center"
        android:textColor="@color/error"
        android:textSize="@dimen/tv_text_size_small"
        android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
