<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <!-- Header with Background Poster -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="252dp">

        <!-- Background Poster (blurred/dimmed) -->
        <ImageView
            android:id="@+id/background_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_playlist_placeholder"
            android:contentDescription="@string/playlists_loading" />

        <!-- Gradient overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_gradient" />

        <!-- Small Poster (left top) -->
        <androidx.cardview.widget.CardView
            android:layout_width="150dp"
            android:layout_height="210dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="8dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/tv_margin_large"
            android:layout_marginTop="@dimen/tv_margin_large">

            <ImageView
                android:id="@+id/playlist_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_playlist_placeholder"
                android:contentDescription="@string/playlists_loading" />
        </androidx.cardview.widget.CardView>

        <!-- Playlist Info (right top) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/tv_margin_large"
            android:layout_marginTop="@dimen/tv_margin_large">

            <!-- Playlist Name -->
            <TextView
                android:id="@+id/playlist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playlist Name"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="end"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Episodes Count -->
            <TextView
                android:id="@+id/episodes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/episodes_count"
                android:textColor="@color/text_gray"
                android:textSize="16sp"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <!-- Media List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/tv_margin_medium"
        android:paddingBottom="@dimen/tv_margin_medium" />

</LinearLayout>
