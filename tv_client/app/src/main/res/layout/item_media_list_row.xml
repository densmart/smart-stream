<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tv_margin_large"
    android:paddingEnd="@dimen/tv_margin_large"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/media_row_selector"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp">

    <!-- Mini Poster -->
    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="56dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/media_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_media_placeholder"
            android:contentDescription="@string/media_loading" />
    </androidx.cardview.widget.CardView>

    <!-- Media Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/media_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Episode Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/media_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="00:45:30"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/media_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/continue_watching"
            android:textColor="@color/green_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
