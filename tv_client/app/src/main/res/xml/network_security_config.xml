<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for development and local servers -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's host alias -->
        <domain includeSubdomains="true">10.0.2.2</domain>

        <!-- localhost variants -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- Local network (192.168.x.x) -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.0.2</domain>
        <domain includeSubdomains="true">192.168.0.3</domain>
        <domain includeSubdomains="true">192.168.0.4</domain>
        <domain includeSubdomains="true">192.168.0.5</domain>
        <domain includeSubdomains="true">192.168.0.6</domain>
        <domain includeSubdomains="true">192.168.0.7</domain>
        <domain includeSubdomains="true">192.168.0.8</domain>
        <domain includeSubdomains="true">192.168.0.9</domain>
        <domain includeSubdomains="true">192.168.0.10</domain>
        <domain includeSubdomains="true">192.168.0.11</domain>
        <domain includeSubdomains="true">192.168.0.12</domain>
        <domain includeSubdomains="true">192.168.0.13</domain>
        <domain includeSubdomains="true">192.168.0.14</domain>
        <domain includeSubdomains="true">192.168.0.15</domain>
        <domain includeSubdomains="true">192.168.0.16</domain>
        <domain includeSubdomains="true">192.168.0.17</domain>
        <domain includeSubdomains="true">192.168.0.18</domain>
        <domain includeSubdomains="true">192.168.0.19</domain>
        <domain includeSubdomains="true">192.168.0.20</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.1.2</domain>
        <domain includeSubdomains="true">192.168.1.3</domain>
        <domain includeSubdomains="true">192.168.1.4</domain>
        <domain includeSubdomains="true">192.168.1.5</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
    </domain-config>

    <!-- For production, you should remove this and use HTTPS only -->
    <!-- <base-config cleartextTrafficPermitted="false" /> -->
</network-security-config>
