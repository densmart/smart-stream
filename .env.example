# ===========================================
# Smart Stream - Environment Configuration
# ===========================================
#
# IMPORTANT: Copy this file to .env and fill in your values
# Do NOT commit .env with real credentials to git!
#

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# При использовании docker-compose эти переменные используются для:
# 1. Создания PostgreSQL контейнера с правильными credentials
# 2. Автоматического построения connection string в backend
#
# ВАРИАНТ 1: Отдельные параметры (рекомендуется для docker-compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_stream
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_SSLMODE=disable

# ВАРИАНТ 2: Полный DSN (используется если задан, имеет приоритет)
# Раскомментируйте и используйте для подключения к внешней БД
# POSTGRES_DSN=postgres://username:password@postgres:5432/smart_stream?sslmode=disable
#
# Примеры для разных сценариев:
# - Docker Compose (внутренняя сеть): postgres://username:password@postgres:5432/smart_stream?sslmode=disable
# - Локальная БД (Mac/Windows): postgres://username:password@host.docker.internal:5432/smart_stream?sslmode=disable
# - Внешняя БД: postgres://username:password@hostname:5432/smart_stream?sslmode=disable

# ===========================================
# API Configuration (Backend)
# ===========================================
# Web Admin API port (default: 17777)
WEB_API_PORT=17777

# TV Client API port (default: 18888)
TV_APP_API_PORT=18888

# ===========================================
# Security
# ===========================================
# JWT Secret for token generation (use strong random string!)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_STRING

# Admin user credentials
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# ===========================================
# Storage Configuration
# ===========================================
# These paths are inside the container and mapped to Docker volumes
# You usually don't need to change these
POSTERS_DIR=/app/storage/posters
MEDIA_DIR=/app/storage/media

# Maximum poster file size in MB
MAX_POSTER_SIZE_MB=10

# ===========================================
# Logging
# ===========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ===========================================
# Frontend Configuration
# ===========================================
# URL where backend API is accessible from the browser
# ВАЖНО: Эта переменная используется при сборке Docker образа frontend
#
# Examples:
# - Development (local): http://localhost:17777
# - Production (same server): http://your-server-ip:17777
# - Production (domain): https://api.example.com
VITE_API_URL=http://localhost:17777

# Port on which frontend will be accessible on host machine (default: 3000)
FRONTEND_PORT=3000