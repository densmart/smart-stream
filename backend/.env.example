# ===========================================
# Smart Stream Backend - Environment Configuration
# ===========================================
#
# IMPORTANT: Copy this file to .env and fill in your values
# Do NOT commit .env with real credentials to git!
#

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection string for external database
# Format: postgres://username:password@host:port/database?sslmode=disable
#
# Examples:
# - БД на той же машине (Mac/Windows): host.docker.internal
# - БД на отдельном сервере: IP адрес или hostname
# - Docker на Linux: 172.17.0.1 или host.docker.internal (Docker 20.10+)
POSTGRES_DSN=postgres://username:password@host.docker.internal:5432/smart_stream?sslmode=disable

# ===========================================
# API Configuration
# ===========================================
# Web Admin API port (default: 17777)
WEB_API_PORT=17777

# TV Client API port (default: 18888)
TV_APP_API_PORT=18888

# ===========================================
# Security
# ===========================================
# JWT Secret for token generation (use strong random string!)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_STRING

# Admin user credentials
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# ===========================================
# Storage Configuration
# ===========================================
# These paths are inside the container and mapped to Docker volumes
# You usually don't need to change these
POSTERS_DIR=/app/storage/posters
MEDIA_DIR=/app/storage/media

# Maximum poster file size in MB
MAX_POSTER_SIZE_MB=10

# ===========================================
# Logging
# ===========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
